<Window x:Class="CybersecurityAwarenessBot.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="800" Width="1100"
        Background="#0D1B2A"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="600">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1B263B" CornerRadius="10" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#0D1B2A" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="CYBER" FontSize="14" FontWeight="Bold" Foreground="#00B4D8" HorizontalAlignment="Center"/>
                        <TextBlock Text="BOT" FontSize="14" FontWeight="Bold" Foreground="#00B4D8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CYBERSECURITY AWARENESS BOT" FontSize="24" FontWeight="Bold" Foreground="#00B4D8"/>
                    <TextBlock Text="Your personal guide to staying safe online" FontSize="14" Foreground="#8D99AE" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#1B263B" BorderThickness="0" Margin="0,0,0,15">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#0D1B2A"/>
                    <Setter Property="Foreground" Value="#8D99AE"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="15,5"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Chat -->
            <TabItem Header="💬 Chat">
                <Border Background="#1B263B" CornerRadius="10" Padding="10">
                    <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ChatPanel" Margin="10"/>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: Task Assistant -->
            <TabItem Header="📋 Task Assistant">
                <Border Background="#1B263B" CornerRadius="10" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Add Task Form -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="TaskTitleBox" Width="200" Padding="5" Margin="0,0,10,0" Background="#0D1B2A" Foreground="#E0E1DD" BorderBrush="#00B4D8" ToolTip="Task Title"/>
                            <TextBox x:Name="TaskDescBox" Width="300" Padding="5" Margin="0,0,10,0" Background="#0D1B2A" Foreground="#E0E1DD" BorderBrush="#00B4D8" ToolTip="Description"/>
                            <DatePicker x:Name="TaskDatePicker" Margin="0,0,10,0" Background="#0D1B2A"/>
                            <Button Content="Add Task" Click="AddTaskBtn_Click" Background="#00B4D8" Foreground="#0D1B2A" FontWeight="Bold" Padding="10,5" BorderThickness="0"/>
                        </StackPanel>

                        <!-- Task List -->
                        <ListBox x:Name="TaskListBox" Grid.Row="1" Background="#0D1B2A" Foreground="#E0E1DD" BorderBrush="#00B4D8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#00B4D8"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8D99AE"/>
                                            <TextBlock Text="{Binding ReminderDate, StringFormat='Reminder: {0:dd MMM yyyy}'}" FontSize="11" Foreground="#FFD166"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✔" Click="CompleteTaskBtn_Click" Tag="{Binding Id}" Background="#2EC4B6" BorderThickness="0" Margin="0,0,5,0" Width="30"/>
                                            <Button Content="✖" Click="DeleteTaskBtn_Click" Tag="{Binding Id}" Background="#E63946" BorderThickness="0" Width="30"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="#1B263B" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputBox" Grid.Column="0" FontSize="14" Padding="10" Background="#0D1B2A" Foreground="#E0E1DD" BorderBrush="#00B4D8" BorderThickness="1" CaretBrush="#00B4D8" KeyDown="UserInputBox_KeyDown" ToolTip="Type your question here..."/>

                <Button x:Name="SendButton" Grid.Column="1" Content="Send" Margin="10,0,0,0" Padding="20,10" FontSize="14" FontWeight="Bold" Background="#00B4D8" Foreground="#0D1B2A" BorderThickness="0" Cursor="Hand" Click="SendButton_Click"/>

                <Button x:Name="VoiceButton" Grid.Column="2" Content="🔊 Replay" Margin="10,0,0,0" Padding="15,10" FontSize="14" Background="#2EC4B6" Foreground="#0D1B2A" BorderThickness="0" Cursor="Hand" Click="VoiceButton_Click" ToolTip="Replay voice greeting"/>
            </Grid>
        </Border>
    </Grid>
</Window>